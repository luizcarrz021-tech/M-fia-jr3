}
function toggle(i){const a=get('mafiaGoals',members.map(m=>({name:m[0],done:false})));a[i].done=!a[i].done;put('mafiaGoals',a);render()}
function openAdmin(){if(prompt('Código do comando:')==='DRAVEN'){show('admin');document.getElementById('msg').value=get('leaderMsg','')}else alert('Código incorreto.')}
function saveMsg(){put('leaderMsg',document.getElementById('msg').value.trim());render();alert('Mensagem salva neste dispositivo.')}
render();
</script>
