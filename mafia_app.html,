const memberData=[['DON DRAVEN','CHEFE [CHF]'],['SALAZAR / SALAZAR2.0','CAPITÃO [CAP]'],['DAVI GOMES / DAVIZX_','LÍDER [LDR]'],['SAGAZ / MAFIOSO','VICE-LÍDER [VLD]'],['LUQ / LUC7','SOLDADO ELITE [SE]'],['P1 LENDARIO','SUB-CHEFE [SCHF]'],['SK','?'],['THEUS','?'],['FROST','?']];
