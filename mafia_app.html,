function show(id){document.querySelectorAll('main>section').forEach(s=>s.classList.add('hidden'));document.getElementById(id).classList.remove('hidden');window.scrollTo(0,0)}
function get(key,def){try{return JSON.parse(localStorage.getItem(key)||JSON.stringify(def))}catch(e){return def}}function put(key,val){localStorage.setItem(key,JSON.stringify(val))}
function drawGoals(){const a=get('mafiaGoals',memberData.map(x=>({name:x[0],done:false})));document.getElementById('goals').innerHTML=a.length?a.map((x,i)=>`<div class="member"><div><b>${x.done?'🕴️ ':''}${escapeHtml(x.name)}</b><small>${x.done?'Meta cumprida':'Meta pendente'}</small></div><button class="btn" style="margin-left:auto" onclick="toggleGoal(${i})">${x.done?'Desmarcar':'Meta batida'}</button></div>`).join(''):'Nenhum membro adicionado ainda.'}
function addGoal(){const n=document.getElementById('goalName').value.trim();if(!n)return;const a=get('mafiaGoals',memberData.map(x=>({name:x[0],done:false})));a.push({name:n,done:false});put('mafiaGoals',a);document.getElementById('goalName').value='';drawGoals()}function toggleGoal(i){const a=get('mafiaGoals',memberData.map(x=>({name:x[0],done:false})));a[i].done=!a[i].done;put('mafiaGoals',a);drawGoals()}
function drawCases(){const a=get('mafiaCases',[]);document.getElementById('cases').innerHTML=a.length?a.map((x,i)=>`<div class="member"><div><b>${escapeHtml(x.name)}</b><small>${escapeHtml(x.reason)}</small></div><button class="btn" style="margin-left:auto" onclick="removeCase(${i})">Resolver</button></div>`).join(''):'Nenhuma pendência registrada.'}function addCase(){const name=document.getElementById('caseName').value.trim(),reason=document.getElementById('caseReason').value.trim();if(!name||!reason)return;const a=get('mafiaCases',[]);a.push({name,reason});put('mafiaCases',a);document.getElementById('caseName').value='';document.getElementById('caseReason').value='';drawCases()}function removeCase(i){const a=get('mafiaCases',[]);a.splice(i,1);put('mafiaCases',a);drawCases()}function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}render();

function openAdmin(){const ok=prompt('Digite o código do comando:');if(ok==='DRAVEN'){document.getElementById('leaderMsg').value=get('leaderMsg','Respeite a hierarquia, cumpra sua parte e trate cada membro com lealdade.');document.getElementById('weeklyGoal').value=get('weeklyGoal',20000);show('admin')}else if(ok!==null){alert('Código incorreto.')}}
function saveLeaderMsg(){put('leaderMsg',document.getElementById('leaderMsg').value.trim());alert('Mensagem oficial atualizada.')}
function saveWeeklyGoal(){const v=Math.max(0,Number(document.getElementById('weeklyGoal').value)||0);put('weeklyGoal',v);document.getElementById('goalLabel').textContent=(v/1000)+'K por semana';alert('Meta atualizada.')}
function initSettings(){const v=get('weeklyGoal',20000);const el=document.getElementById('goalLabel');if(el)el.textContent=(v/1000)+'K por semana';const m=get('leaderMsg',null);if(m){const n=document.querySelector('#home .notice');if(n)n.textContent=m;}}
const _render=render; render=function(){_render();initSettings()};
</script></body></html>

